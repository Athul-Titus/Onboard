# OnboardOS Environment Configuration
APP_NAME=OnboardOS
APP_ENV=development
PORT=8000
HOST=0.0.0.0
DEBUG=True

# LLM Configuration
# Providers: openai, gemini, anthropic, mock
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Set to True to run LLM operations via deterministic built-in mock fallback (zero cost / offline testing)
MOCK_LLM_MODE=False

# Storage & Database
DATABASE_URL=sqlite:///./onboardos.db
CHROMA_PERSIST_DIR=./chroma_db

# Optional GitHub API Token for higher rate limits when verifying hire profiles
GITHUB_TOKEN=

# Orchestrator & Scoring Configuration
SCORE_WEIGHT_SKILL_MATCH=0.40
SCORE_WEIGHT_GAP_COVERAGE=0.25
SCORE_WEIGHT_CAPACITY=0.20
SCORE_WEIGHT_LEARNING_GAP=0.15
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
